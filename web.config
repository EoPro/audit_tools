<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración para IIS (Windows Server) que permite incrustar esta página
  en un iframe de otro sitio.

  Con la cabecera "Content-Security-Policy: frame-ancestors *" los navegadores
  ignoran "X-Frame-Options", por lo que no hace falta quitar esa cabecera.
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!-- Si el servidor define X-Frame-Options y quiere eliminarla, descomente:
        <remove name="X-Frame-Options" />
        -->
        <add name="Content-Security-Policy" value="frame-ancestors *" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
    </staticContent>
  </system.webServer>
</configuration>
